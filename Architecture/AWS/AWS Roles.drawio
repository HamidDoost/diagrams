          </mxCell>
        </UserObject>
        <mxCell id="-UrRd8y1_MKKvQfsvz9V-91" style="vsdxID=65;fillColor=#ffffff;gradientColor=none;fillOpacity=0;shape=stencil();strokeColor=none;strokeWidth=0;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[[0,0.5,0],[1,0.5,0],[0.5,1,0],[0.5,0,0]];labelBackgroundColor=none;rounded=1;html=1;whiteSpace=wrap;" vertex="1" parent="-UrRd8y1_MKKvQfsvz9V-90">
          <mxGeometry width="1179" height="180" as="geometry" />
        </mxCell>
        <mxCell id="-UrRd8y1_MKKvQfsvz9V-92" value="&lt;div style=&quot;font-size: 1px&quot;&gt;&lt;p style=&quot;text-align:left;margin-left:0;margin-right:0;margin-top:0px;margin-bottom:0px;text-indent:0;vertical-align:middle;direction:ltr;&quot;&gt;&lt;font style=&quot;font-size:21.17px;font-family:Arial;color:#16191f;direction:ltr;letter-spacing:0px;line-height:125%;opacity:1&quot;&gt;&lt;b&gt;Role for cross-account access&lt;/b&gt;&lt;/font&gt;&lt;font style=&quot;font-size:19.76px;font-family:Arial;color:#ffffff;direction:ltr;letter-spacing:0px;line-height:125%;opacity:1&quot;&gt;&lt;br/&gt;&lt;/font&gt;&lt;font style=&quot;font-size:19.76px;font-family:Arial;color:#16191f;direction:ltr;letter-spacing:0px;line-height:125%;opacity:1&quot;&gt;A role that grants access to resources in one account to a trusted principal in a different account.&lt;br/&gt;Roles are the primary way to grant cross-account access. However, some AWS services allow you to attach a policy directly to a resource (instead of using a role as a proxy). These are called resource-based policies, and you can use them to grant principals in another AWS account access to the resource. Some of these resources include Amazon Simple Storage Service (S3) buckets, S3 Glacier vaults, Amazon Simple Notification Service (SNS) topics, and Amazon Simple Queue Service (SQS) queues.&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" style="text;vsdxID=64;fillColor=none;gradientColor=none;fillOpacity=0;strokeColor=none;strokeWidth=0;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[[0,0.5,0],[1,0.5,0],[0.5,1,0],[0.5,0,0]];labelBackgroundColor=none;rounded=1;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;overflow=width;;html=1;" vertex="1" parent="-UrRd8y1_MKKvQfsvz9V-90">
          <mxGeometry x="3.18" y="2.83" width="1173.48" height="174.63" as="geometry" />
        </mxCell>
